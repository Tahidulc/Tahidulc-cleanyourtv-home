<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings, Updates: a newer Homefield TV put on this TV handed to Android's installer (it asks first). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reminders: a card a minute before a programme, over other apps when Android allows it (asked for once), else a
         notification; their alarm exact where Android allows, never one that wakes the TV, made again after a restart. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A TV app only: Android TV's launcher row, the remote, no touch screen. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Automatic subtitles: whether the TV has a speech recogniser of its own (else Vosk's offline one, on request). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Sync (sync.TvSync): the launcher on this TV hands this app its token and passes everything on. -->
        <package android:name="com.gathin.tvhome" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Homefield"
        android:networkSecurityConfig="@xml/network_security"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".TvActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A film or an episode from the family's own playlist, full screen. -->
        <activity
            android:name=".VodActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- Android's installer's word on an update (Updates): only its PendingIntent reaches it. -->
        <receiver
            android:name=".UpdateStatus"
            android:exported="false" />

        <!-- Reminders' alarm (its own PendingIntent), and Android's word that the TV started or the app was updated. -->
        <receiver
            android:name=".ReminderAlarm"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A reminder's card brought up by its notification where it can't be shown over other apps. -->
        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- A playlist added from a computer over adb, so a long login need not be typed on the remote:
             content insert - -uri content://com.gathin.homefieldtv.setup/xtream - -bind server:s:… (see Setup). Only the
             adb shell holds WRITE_SECURE_SETTINGS; ordinary apps cannot get it. -->
        <provider
            android:name=".engine.Setup"
            android:authorities="${applicationId}.setup"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
