<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit at weight 800 for the scoreboard (BoardBug): a variable font's own weight, set in the resource (asking the
     font file for a weight draws its thin default instance). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/outfit"
        android:fontStyle="normal"
        android:fontWeight="800"
        android:fontVariationSettings="'wght' 800"
        tools:targetApi="28" />
</font-family>
