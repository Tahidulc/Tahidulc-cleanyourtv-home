<?xml version="1.0" encoding="utf-8"?>
<!-- An alert, opened out: as sports_notification, with all its lines (the scorers, both line-ups) and the channel's
     logo under them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sports_notif_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/sports_notif_chip"
            android:padding="3dp"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/sports_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>

    <TextView
        android:id="@+id/sports_notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="12"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <ImageView
        android:id="@+id/sports_notif_channel"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:background="@drawable/sports_notif_chip"
        android:maxWidth="140dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />
</LinearLayout>
