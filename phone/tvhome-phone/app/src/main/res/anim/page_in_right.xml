<?xml version="1.0" encoding="utf-8"?>
<!-- A page sliding as the tab bar's lens moves to its tab: in from the side it lies, out to the other. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:anim/decelerate_interpolator">
    <translate android:fromXDelta="22%" android:toXDelta="0%" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.97" android:toXScale="1" android:fromYScale="0.97" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
