<?xml version="1.0" encoding="utf-8"?>
<!-- "Your club" on the home screen: four by two, resizable; drawn from the app's polls of the games. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/f2_widget_about"
    android:initialLayout="@layout/widget_club"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:previewImage="@drawable/widget_preview_bug"
    android:previewLayout="@layout/widget_club_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
