<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Finding the TVs on the home network (mDNS "_tvhome._tcp", as Delivery to TV does). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live games: the alerts' own service, with its notification, while a followed game is on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The scoreboard over other apps, when switched on (FloatService). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Alerts (phone-sports): an exact alarm fifteen minutes before a followed kick-off, which also lets the live
         watcher start from the background on Android 12 and later. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Homefield's own updates, from the family's TVs (update.AppUpdate): a new version of itself installed, and on
         Android 12 and later, once Homefield may install apps, without Android asking again each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- The streaming apps a title can be opened in (Watch: the licensed app on the phone that carries it, or its store). -->
    <queries>
        <!-- Debrid Stream, which Play hands a title to (the agreed rule), seen by its own name too. -->
        <package android:name="com.debridstream.tv" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- The phone's own speech recognition, for automatic subtitles on live TV (made on the phone). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:roundIcon="@drawable/ic_app"
        android:theme="@style/Theme.TvHome"
        android:networkSecurityConfig="@xml/network_security"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watch (phone-watch): a film's or series' page. -->
        <activity android:name=".watch.TitleActivity" android:exported="false" />
        <!-- The family's own matchday intro video: Android's file picker, then it is kept and sent to the TVs. -->
        <activity
            android:name=".live.PickIntroActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Live TV (phone-sports): the player, full screen. -->
        <!-- Watch: a film or episode from the family's own playlist (Vod), full screen on its side. -->
        <activity
            android:name=".live.VodPlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- Two games at once, on the phone on its side. -->
        <activity
            android:name=".live.TwoGamesActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <activity
            android:name=".live.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask" />

        <!-- Alerts (phone-sports): the live games' watcher while one is on. -->
        <service
            android:name=".sports.AlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The scoreboard over other apps, while switched on: the live scores read every 15 seconds. -->
        <service
            android:name=".live.FloatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Alerts (phone-sports): the kick-off alarm, and a game's own page. -->
        <receiver android:name=".sports.AlarmReceiver" android:exported="false" />
        <receiver android:name=".sports.MuteReceiver" android:exported="false" />
        <activity android:name=".sports.GameActivity" android:exported="false" />
        <!-- Another sport's event (an NFL or NBA game, a tennis match, a UFC card, a Grand Prix, golf, a listing):
             every channel showing it and its highlights. -->
        <activity android:name=".sports.EventActivity" android:exported="false" />
        <!-- A club's own page (from a table's row or a game's crest): form, season figures, leading players, squad. -->
        <activity android:name=".sports.TeamActivity" android:exported="false" />
        <!-- A player's page from the club page's squad, and an F1 driver's from Sports' Formula 1 (swiped through). -->
        <activity android:name=".sports.PlayerPageActivity" android:exported="false" />
        <activity android:name=".sports.DriverActivity" android:exported="false" />
        <!-- A highlight clip (ESPN's own), full screen. -->
        <activity
            android:name=".sports.ClipPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- Kick-off in 2 minutes: its alarm, and its "Not now". -->
        <receiver android:name=".sports.KickOffReceiver" android:exported="false" />

        <!-- The "Your club" home-screen widget. -->
        <receiver android:name=".sports.ClubWidget" android:exported="false" android:label="@string/f2_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/club_widget_info" />
        </receiver>

        <!-- Cast from Live TV: Cast reads how it is set up (Google's own player on the device) from this class. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.gathin.tvhomephone.cast.CastSetup" />

        <!-- Homefield's own updates: Android's installer's word on one, and the new version saying it is in. -->
        <receiver android:name=".update.InstallStatus" android:exported="false" />
        <receiver android:name=".update.Updated" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".sports.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
