<?xml version="1.0" encoding="utf-8"?>
<!-- Reads an app's screen: Debrid Stream's, to open its search for a trending tile's title and to note the titles of
     its Continue Watching row as they are highlighted (that app's events only, at most every 400 ms); TiviMate's, to
     find a tile's channel through its search (its views are marked unimportant, hence the flags), and its channel
     banner as the channel changes, at most every second, for a match or F1 being watched (OverlayPrompt); Tuya Smart's, to
     open a camera's live view, magnified to fill the screen. Keys only while pop-up mode is open on a TV without the
     key helper (a TCL, whose remote loses its key repeat while any service filters keys): switched on and off at
     runtime (AppSearchService.keysForPopup), never otherwise. Pictures of the screen (Android 11 and later) while a
     match plays in TiviMate under the scoreboard, to find the channel's own scoreboard and read its clock
     (ChannelSight) and to learn the channel's logo stroke by stroke for see-through (LogoShape): made small at once,
     never sent, never written down (only the logo's learned shape is kept, no picture). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canControlMagnification="true"
    android:canRequestFilterKeyEvents="true"
    android:canTakeScreenshot="true"
    android:accessibilityEventTypes="typeViewFocused|typeWindowContentChanged"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:packageNames="com.debridstream.tv,ar.tvplayer.tv"
    android:notificationTimeout="400"
    android:description="@string/app_search_service_description" />
