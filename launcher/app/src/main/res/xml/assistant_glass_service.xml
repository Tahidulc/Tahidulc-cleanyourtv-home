<?xml version="1.0" encoding="utf-8"?>
<!-- Reads Google Assistant's transcript only; no key filtering, so the remote's repeat is untouched. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:packageNames="com.google.android.katniss"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="80"
    android:description="@string/assistant_glass_description" />
