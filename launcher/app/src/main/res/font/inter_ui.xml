<?xml version="1.0" encoding="utf-8"?>
<!-- Inter (SIL OFL 1.1), regular and semibold as one family, so bold spans use the real semibold. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/inter_regular" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/inter_semibold" />
</font-family>
