<?xml version="1.0" encoding="utf-8"?>
<!-- Solid silver pill (a theme's "silver_pills"): brushed light metal, brighter at the top, dark text and icons;
     focused it turns brighter with a white ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE3E8EE" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB9D9F5" />
            <stroke android:width="1.5dp" android:color="#FF4A90D9" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFF3F5F8" android:centerColor="#FFDDE2E8" android:endColor="#FFC3CAD3" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
