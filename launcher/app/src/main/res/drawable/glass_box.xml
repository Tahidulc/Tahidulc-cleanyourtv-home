<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted "liquid glass" box for the tickers: the top pills' fill and rim, with a soft sheen along the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="14dp" android:right="14dp" android:top="1dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#29FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
