<?xml version="1.0" encoding="utf-8"?>
<!-- A top-bar pill in the glass theme: clear glass; focused, it turns bright white as tvOS does. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE9EDF3" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#663A8DFF" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/glass_dark" />
</selector>
