<?xml version="1.0" encoding="utf-8"?>
<!-- A pill on a light wallpaper (a theme's "light_ui"): liquid glass (a clear body, a dark hairline outside, a bright
     rim inside and a sheen across the top); focused, solid ink so the button in focus is plain to see. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1D2128" />
            <stroke android:width="1dp" android:color="#FF1D2128" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB9D9F5" />
            <stroke android:width="1.5dp" android:color="#FF4A90D9" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/glass_light" />
</selector>
