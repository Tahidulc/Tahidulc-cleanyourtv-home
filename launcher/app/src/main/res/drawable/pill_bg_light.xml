<?xml version="1.0" encoding="utf-8"?>
<!-- A pill on a light wallpaper (a theme's "light_ui"): white with a hairline edge; focused, a dark ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="2.5dp" android:color="#FF1D2128" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB9D9F5" />
            <stroke android:width="1.5dp" android:color="#FF4A90D9" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFF4F5F7" />
            <stroke android:width="1dp" android:color="#1F000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
